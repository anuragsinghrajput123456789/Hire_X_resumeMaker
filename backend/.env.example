# ============================================================
# Hire-X Backend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/hirex
# MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/hire-x?retryWrites=true&w=majority

# Security — JWT Secret (must be at least 32 characters)
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_long

# AI Provider Configuration
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Gemini API Key (if using native Gemini API instead of OpenRouter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI Usage & Limits
AI_USAGE_LIMIT=500
AI_MAX_CONCURRENCY=3
AI_USAGE_WHITELIST=

# CORS — Frontend Origin (comma-separated for multiple)
# Development: http://localhost:8080
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:8080

# OpenRouter HTTP Referer (for tracking on OpenRouter dashboard)
OPENROUTER_REFERER=http://localhost:8080

# Admin Email (for admin-only routes)
ADMIN_EMAIL=

# Optional: Cloudflare Turnstile (bot protection)
# TURNSTILE_SECRET_KEY=

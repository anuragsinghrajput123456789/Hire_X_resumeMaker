# ============================================================
# Hire-X Backend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ------ Server ------
NODE_ENV=development
PORT=5000

# ------ MongoDB Connection String ------
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/hirex
# MongoDB Atlas (production — set in Render environment variables):
# MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/hirex?retryWrites=true&w=majority

# ------ Security — JWT Secret (must be at least 32 characters) ------
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_long

# ------ AI Provider Configuration ------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Gemini API Key (only if using native Gemini API instead of OpenRouter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------ AI Usage & Limits ------
AI_USAGE_LIMIT=500
AI_MAX_CONCURRENCY=3
AI_USAGE_WHITELIST=

# ------ CORS — Frontend Origin ------
# Comma-separated for multiple origins.
# Development (Vite default port):
CLIENT_URL=http://localhost:8080
# Production (set in Render environment variables):
# CLIENT_URL=https://your-hirex-app.vercel.app

# ------ OpenRouter HTTP Referer ------
# Used for tracking on OpenRouter dashboard. Set to your production frontend URL.
# Development:
OPENROUTER_REFERER=http://localhost:8080
# Production (set in Render environment variables):
# OPENROUTER_REFERER=https://your-hirex-app.vercel.app

# ------ Admin Email (for admin-only routes) ------
ADMIN_EMAIL=

# ------ Optional: Cloudflare Turnstile (bot protection) ------
# TURNSTILE_SECRET_KEY=

# Production Environment Configuration Template
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
# Replace username, password, and cluster URI with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/hire-x?retryWrites=true&w=majority

# Security Secrets (Must be at least 32 characters long)
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_chars

# AI Layer & OpenRouter Gateway Configuration
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_REFERER=https://your-app.vercel.app

# System Limits & Concurrency
AI_USAGE_LIMIT=500
AI_MAX_CONCURRENCY=3
AI_USAGE_WHITELIST=admin@hire-x.com

# CORS Allowed Origin (Vercel Frontend Production Domain)
CLIENT_URL=https://your-app.vercel.app

# ============================================================
# Hire-X Frontend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# All frontend env vars MUST start with VITE_ to be accessible.
# NEVER put API keys or secrets here — they are exposed to the browser.
# ============================================================

# Backend API URL
# Development (local backend on port 5000):
VITE_API_URL=http://localhost:5000/api

# Production (set in Vercel project settings):
# VITE_API_URL=https://your-hirex-backend.onrender.com/api
